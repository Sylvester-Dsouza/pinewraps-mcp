# Port this MCP server listens on. Leave unset on hosts (Railway, Render) that inject
# their own PORT — hardcoding it here can break routing.
PORT=3900

# This server's own public HTTPS URL (no trailing path), used as the OAuth issuer.
# Required. Example: https://pinewraps-mcp-production.up.railway.app
PUBLIC_URL=http://localhost:3900

# Base URL of the Pinewraps API (e.g. https://pinewraps-api.onrender.com)
PINEWRAPS_API_URL=http://localhost:3001

# Value of MCP_API_KEY configured on pinewraps-api (see ../api-integration/README.md)
PINEWRAPS_API_KEY=

# One-time password required on the OAuth consent page before Claude is granted access.
# Generate with `openssl rand -hex 32`. Not sent on every request — only used once per
# connector approval (and after token expiry/revocation).
MCP_SERVER_ACCESS_TOKEN=

# Optional: where registered OAuth clients + refresh tokens are persisted to disk.
# Defaults to ./data/oauth-store.json. Mount a persistent volume at this path's directory
# on your host if you want it to survive a full redeploy (not just a process restart).
# OAUTH_STORE_PATH=./data/oauth-store.json
